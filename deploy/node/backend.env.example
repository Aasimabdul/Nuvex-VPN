# Copy to /etc/nuvex/backend.env on the node (chmod 640, owner root:nuvex).
PORT=8080
NUVEX_NODE_ID=sg-1
NUVEX_NODE_COUNTRY_CODE=SG
NUVEX_NODE_COUNTRY_NAME=Singapore
NUVEX_NODE_CITY=Singapore
# Public IP of this VPS and the WireGuard port.
NUVEX_NODE_ENDPOINT=203.0.113.10:51820
# Printed by setup-node.sh (contents of /etc/wireguard/server.pub).
NUVEX_NODE_PUBLIC_KEY=
NUVEX_WG_INTERFACE=wg0
NUVEX_NODE_SUBNET_PREFIX=10.66.0.
NUVEX_NODE_DNS=1.1.1.1
# Set to true only when a reverse proxy such as Caddy overwrites X-Forwarded-For.
NUVEX_TRUST_PROXY_HEADER=true
